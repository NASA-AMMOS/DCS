<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gov.nasa.jpl.ammos.kmc</groupId>
    <artifactId>asec-kmc</artifactId>
    <version>4.0.0</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <!-- groupId differs from parent on purpose: must match kmc-sdls-service's dependency -->
  <groupId>gov.nasa.jpl.ammos.asec.kmc</groupId>
  <artifactId>KmcSdlsJNI</artifactId>
  <packaging>jar</packaging>
  <!-- version inherited from parent (4.0.0); do NOT hard-code it here -->

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Overridden by CMake. Package ROOT of SWIG output (dir containing gov/), not the leaf dir. -->
    <swig.generated.dir>${project.basedir}/swig-java</swig.generated.dir>
    <!-- Overridden by CMake. Dir containing libkmc_sdls_java / libkmc_sdls. -->
    <native.lib.dir>${project.basedir}/../../build/lib</native.lib.dir>
    <skipTests>true</skipTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>KmcSdlsJNI</finalName>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-swig-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${swig.generated.dir}</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${skipTests}</skipTests>
          <workingDirectory>${project.basedir}/src/test/resources</workingDirectory>
          <argLine>-Djava.library.path=${native.lib.dir}</argLine>
          <environmentVariables>
            <LD_LIBRARY_PATH>${native.lib.dir}</LD_LIBRARY_PATH>
            <DYLD_LIBRARY_PATH>${native.lib.dir}</DYLD_LIBRARY_PATH>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
